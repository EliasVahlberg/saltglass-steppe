{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://saltglass-steppe.game/schemas/items_v1.json",
  "title": "Item Definition Schema",
  "description": "Schema for item definitions in Saltglass Steppe (v1)",
  "type": "object",
  "required": [
    "schema",
    "items"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "const": "items_v1",
      "description": "Schema version identifier"
    },
    "items": {
      "type": "array",
      "description": "Array of item definitions",
      "items": {
        "$ref": "#/$defs/item"
      }
    }
  },
  "$defs": {
    "item": {
      "type": "object",
      "required": [
        "id",
        "name",
        "glyph",
        "description"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "description": "Unique identifier (snake_case)"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Display name"
        },
        "glyph": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1,
          "description": "Single character for rendering"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "description": "Lore description"
        },
        "value": {
          "type": "integer",
          "minimum": 0,
          "default": 0,
          "description": "Trade value"
        },
        "weight": {
          "type": "integer",
          "minimum": 0,
          "default": 0,
          "description": "Carry weight"
        },
        "usable": {
          "type": "boolean",
          "default": false,
          "description": "Can be used/activated"
        },
        "heal": {
          "type": "integer",
          "minimum": 0,
          "default": 0,
          "description": "HP restored on use"
        },
        "reveals_map": {
          "type": "boolean",
          "default": false,
          "description": "Reveals local map"
        },
        "suppresses_adaptations": {
          "type": "boolean",
          "default": false,
          "description": "Disables adaptation effects"
        },
        "breaks_walls": {
          "type": "boolean",
          "default": false,
          "description": "Can break walls"
        },
        "reveals_storm_path": {
          "type": "boolean",
          "default": false,
          "description": "Shows storm path"
        },
        "reduces_refraction": {
          "type": "integer",
          "minimum": 0,
          "default": 0,
          "description": "Refraction reduction value"
        },
        "grants_invisibility": {
          "type": "boolean",
          "default": false,
          "description": "Grants invisibility"
        },
        "reveals_storm_timing": {
          "type": "boolean",
          "default": false,
          "description": "Shows storm timing"
        },
        "reveals_locations": {
          "type": "boolean",
          "default": false,
          "description": "Reveals points of interest"
        },
        "stackable": {
          "type": "boolean",
          "default": false,
          "description": "Stacks in inventory"
        },
        "grows_over_time": {
          "type": "boolean",
          "default": false,
          "description": "Upgrades/grows over time"
        },
        "book_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "description": "Associated book ID"
        },
        "armor_value": {
          "type": "integer",
          "minimum": 0,
          "default": 0,
          "description": "Armor provided when equipped"
        },
        "equip_slot": {
          "type": "string",
          "description": "Equipment slot name"
        },
        "effects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/entity_effect"
          },
          "default": [],
          "description": "Visual/audio effects"
        },
        "hidden_properties": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Properties hidden from UI"
        },
        "pickup": {
          "type": "boolean",
          "default": true,
          "description": "Can be picked up"
        },
        "light_source": {
          "$ref": "#/$defs/light_source",
          "description": "Field `light_source`."
        },
        "enables_aria_dialogue": {
          "type": "boolean",
          "default": false,
          "description": "Unlocks Aria dialogue"
        },
        "consumable": {
          "type": "boolean",
          "default": true,
          "description": "Consumed on use"
        },
        "tier": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10,
          "default": 1,
          "description": "Power/rarity tier"
        },
        "grants_sprint": {
          "type": "boolean",
          "default": false,
          "description": "Boolean field `grants_sprint`."
        },
        "absorbs_light": {
          "type": "boolean",
          "default": false,
          "description": "Boolean field `absorbs_light`."
        },
        "sonic_weapon": {
          "type": "boolean",
          "default": false,
          "description": "Boolean field `sonic_weapon`."
        },
