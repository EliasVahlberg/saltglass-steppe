{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://saltglass-steppe.game/schemas/prefabs_v1.json",
  "title": "Prefab Library Schema",
  "description": "Schema for building prefabs in Saltglass Steppe (v1). Prefabs define reusable building layouts for settlement generation.",
  "type": "object",
  "required": ["schema", "prefabs"],
  "properties": {
    "schema": {
      "type": "string",
      "const": "prefabs_v1",
      "description": "Schema version identifier"
    },
    "prefabs": {
      "type": "array",
      "description": "Array of building prefab definitions",
      "items": {
        "$ref": "#/definitions/Prefab"
      }
    }
  },
  "definitions": {
    "Prefab": {
      "type": "object",
      "required": ["name", "width", "height", "pattern", "legend"],
      "properties": {
        "name": {
          "type": "string",
          "description": "Unique identifier for this prefab (e.g., 'town_hall', 'general_store')"
        },
        "width": {
          "type": "integer",
          "minimum": 3,
          "maximum": 50,
          "description": "Width of the prefab in tiles"
        },
        "height": {
          "type": "integer",
          "minimum": 3,
          "maximum": 50,
          "description": "Height of the prefab in tiles"
        },
        "pattern": {
          "type": "array",
          "description": "Array of strings representing the prefab layout (top to bottom). Each string must be exactly 'width' characters long.",
          "items": {
            "type": "string"
          }
        },
        "legend": {
          "type": "object",
          "description": "Mapping of pattern characters to tile definitions",
          "additionalProperties": {
            "$ref": "#/definitions/LegendEntry"
          }
        },
        "weight": {
          "type": "number",
          "minimum": 0.0,
          "default": 1.0,
          "description": "Weight for weighted random selection (higher = more likely)"
        },
        "tags": {
          "type": "array",
          "description": "Tags for filtering (e.g., 'core', 'residential', 'commercial', 'government')",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "faction": {
          "type": ["string", "null"],
          "description": "Faction ID if this is a faction-specific building (null for neutral buildings)",
          "default": null
        },
        "metadata": {
          "$ref": "#/definitions/PrefabMetadata",
          "description": "Additional metadata for building placement and behavior"
        }
      }
    },
    "LegendEntry": {
      "type": "object",
      "required": ["tile"],
      "properties": {
        "tile": {
          "type": "string",
          "description": "Tile type ID (e.g., 'stone_wall', 'wood_floor', 'door')"
        },
        "marker": {
          "type": ["string", "null"],
          "description": "Optional marker for furniture/decorations (e.g., 'table', 'chair', 'bed')",
          "default": null
        },
        "mask": {
          "type": ["string", "null"],
          "description": "Optional mask for conditional placement (e.g., 'entrance', 'window')",
          "default": null
        }
      }
    },
    "PrefabMetadata": {
      "type": "object",
      "properties": {
        "entrance_side": {
          "type": "string",
          "enum": ["north", "south", "east", "west", "any"],
          "default": "any",
          "description": "Preferred entrance direction for building placement"
        },
        "has_interior": {
          "type": "boolean",
          "default": false,
          "description": "Whether this building has a separate interior map"
        },
        "npc_count": {
          "type": "integer",
          "minimum": 0,
          "default": 0,
          "description": "Number of NPCs to spawn in this building"
        },
        "npc_types": {
          "type": "array",
          "description": "Types of NPCs to spawn (e.g., 'vendor', 'guard', 'innkeeper')",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "description": {
          "type": "string",
          "description": "Lore-friendly description of the building",
          "default": ""
        }
      }
    }
  }
}
