{
  "$id": "https://saltglass-steppe.game/schemas/map_elements_v1.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Map Elements Schema",
  "description": "Unified schema for map tile definitions and light sources (draft v1).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "tiles",
    "lights"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "const": "map_elements_v1",
      "description": "Schema identifier for versioning."
    },
    "tiles": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "walls",
        "floors"
      ],
      "properties": {
        "walls": {
          "type": "array",
          "minItems": 1,
          "description": "Wall tile definitions.",
          "items": {
            "$ref": "#/$defs/wall"
          }
        },
        "floors": {
          "type": "array",
          "minItems": 1,
          "description": "Floor tile definitions.",
          "items": {
            "$ref": "#/$defs/floor"
          }
        }
      }
    },
    "lights": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "defs",
        "spawn_rules"
      ],
      "properties": {
        "defs": {
          "type": "array",
          "minItems": 1,
          "description": "Light source definitions.",
          "items": {
            "$ref": "#/$defs/light_def"
          }
        },
        "spawn_rules": {
          "type": "object",
          "description": "Biome-specific light spawn rules.",
          "required": [
            "default"
          ],
          "patternProperties": {
            "^[a-z][a-z0-9_]*$": {
              "$ref": "#/$defs/spawn_rule"
            }
          },
          "additionalProperties": false
        }
      }
    }
  },
  "$defs": {
    "wall": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "glyph",
        "color",
        "hp",
        "description"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "description": "Unique wall identifier (snake_case)."
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Display name."
        },
        "glyph": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1,
          "description": "Single character used for rendering."
        },
        "color": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z][A-Za-z0-9_]*$",
          "description": "Color token used by the renderer."
        },
        "hp": {
          "type": "integer",
          "minimum": 1,
          "description": "Hit points required to break the wall."
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "description": "Lore description shown in UI."
        }
      }
    },
    "floor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "glyph",
        "color",
        "description"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "description": "Unique floor identifier (snake_case)."
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Display name."
        },
        "glyph": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1,
          "description": "Single character used for rendering."
        },
        "color": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z][A-Za-z0-9_]*$",
          "description": "Color token used by the renderer."
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "description": "Lore description shown in UI."
        }
      }
    },
    "light_def": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "glyph",
        "radius",
        "intensity",
        "color"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "description": "Unique light identifier (snake_case)."
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Display name."
        },
        "glyph": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1,
          "description": "Single character used for rendering."
        },
        "radius": {
          "type": "integer",
          "minimum": 1,
          "description": "Light radius in tiles."
        },
        "intensity": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255,
          "description": "Light intensity (0-255)."
        },
        "color": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z][A-Za-z0-9_]*$",
          "description": "Color token used by the renderer."
        }
      }
    },
    "spawn_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lights_per_room",
        "weights"
      ],
      "properties": {
        "lights_per_room": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "description": "[min, max] lights to place in a room."
        },
        "weights": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          },
          "description": "Weighted light IDs for random selection."
        }
      }
    }
  }
}
