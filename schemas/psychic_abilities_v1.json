{
  "$id": "https://saltglass-steppe.game/schemas/psychic_abilities_v1.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Psychic Abilities Schema",
  "deprecated": true,
  "x-deprecated-by": "abilities_v1.json",
  "x-deprecation-note": "Pending consolidation into abilities_v1.json (category=psychic).",
  "type": "object",
  "description": "Psychic ability definitions gated by adaptation and coherence cost.",
  "additionalProperties": false,
  "required": ["abilities"],
  "properties": {
    "abilities": {
      "type": "array",
      "minItems": 1,
      "description": "List of psychic abilities.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "category",
          "description",
          "coherence_cost",
          "cooldown",
          "min_adaptation_level",
          "effect"
        ],
        "properties": {
          "category": {
            "type": "string",
            "enum": ["telepathy", "probability", "energy", "phasing", "temporal"],
            "description": "Psychic discipline or school."
          },
          "coherence_cost": {
            "type": "integer",
            "minimum": 0,
            "description": "Coherence drained on use."
          },
          "cooldown": {
            "type": "integer",
            "minimum": 0,
            "description": "Turns before the psychic ability can be reused."
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "description": "Player-facing explanation of the psychic ability."
          },
          "effect": {
            "type": "string",
            "minLength": 1,
            "description": "Effect identifier executed by the psychic system."
          },
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$",
            "description": "Stable snake_case identifier for the psychic ability."
          },
          "min_adaptation_level": {
            "type": "integer",
            "minimum": 0,
            "description": "Minimum adaptation level required to unlock."
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "Display name shown to the player."
          }
        }
      }
    }
  }
}
