{
  "$id": "https://saltglass-steppe.game/schemas/progression_v1.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Progression Schema",
  "type": "object",
  "description": "Leveling thresholds and stat growth configuration.",
  "additionalProperties": false,
  "required": ["level_thresholds", "stat_points_per_level", "stat_growth"],
  "properties": {
    "level_thresholds": {
      "type": "array",
      "minItems": 1,
      "description": "XP required to reach each level (index-based).",
      "items": {
        "type": "integer",
        "minimum": 0
      }
    },
    "stat_growth": {
      "type": "object",
      "additionalProperties": false,
      "description": "Automatic stat increases per level.",
      "required": ["max_hp", "max_ap"],
      "properties": {
        "max_ap": {
          "type": "integer",
          "minimum": 0,
          "description": "Action points gained per level."
        },
        "max_hp": {
          "type": "integer",
          "minimum": 0,
          "description": "Hit points gained per level."
        }
      }
    },
    "stat_points_per_level": {
      "type": "integer",
      "minimum": 0,
      "description": "Allocatable stat points granted per level."
    }
  }
}
