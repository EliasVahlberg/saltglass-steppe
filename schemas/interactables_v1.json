{
  "$id": "https://saltglass-steppe.game/schemas/interactables_v1.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "required": [
    "interactables"
  ],
  "properties": {
    "interactables": {
      "items": {
        "oneOf": [
          {
            "additionalProperties": false,
            "properties": {
              "description": {
                "type": "string",
                "description": "Lore or UI description.",
                "minLength": 1
              },
              "glyph": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1,
                "description": "Single-character glyph for rendering."
              },
              "id": {
                "type": "string",
                "description": "Unique identifier (snake_case).",
                "minLength": 1,
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "interaction_type": {
                "type": "string",
                "enum": ["toggle", "press", "aria_interface"],
                "description": "Interaction behavior type."
              },
              "messages": {
                "additionalProperties": false,
                "properties": {
                  "examine": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Examine text, may include {state} placeholder."
                  },
                  "interact": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Interaction result text."
                  }
                },
                "type": "object",
                "description": "Object for `messages`."
              },
              "name": {
                "type": "string",
                "description": "Display name.",
                "minLength": 1
              },
              "states": {
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "description": "Ordered list of valid state labels."
              }
            },
            "required": ["id","name","glyph","description","interaction_type","states","messages"],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "aria_personality": {
                "type": "string",
                "minLength": 1,
                "description": "ARIA personality profile id."
              },
              "description": {
                "type": "string",
                "description": "Lore or UI description.",
                "minLength": 1
              },
              "glyph": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1,
                "description": "Single-character glyph for rendering."
              },
              "id": {
                "type": "string",
                "description": "Unique identifier (snake_case).",
                "minLength": 1,
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "interaction_type": {
                "type": "string",
                "enum": ["toggle", "press", "aria_interface"],
                "description": "Interaction behavior type."
              },
              "messages": {
                "additionalProperties": false,
                "properties": {
                  "examine": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Examine text, may include {state} placeholder."
                  },
                  "interact": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Interaction result text."
                  }
                },
                "type": "object",
                "description": "Object for `messages`."
              },
              "name": {
                "type": "string",
                "description": "Display name.",
                "minLength": 1
              },
              "required_item": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$",
                "description": "Required item id to activate the interactable."
              },
              "states": {
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "description": "Ordered list of valid state labels."
              }
            },
            "type": "object"
          }
        ]
      },
      "type": "array",
      "description": "Array of `interactables` items."
    }
  },
  "title": "Interactables Schema",
  "type": "object",
  "description": "Schema for interactable world objects."
}
