  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Effects Schema",
  "x-consolidates": ["status_effects_v1.json", "effects_config_v1.json"],
  "type": "object",
  "description": "Conditional visual or gameplay effects triggered by runtime state.",
  "additionalProperties": false,
  "required": ["schema", "effects", "status_effects", "config"],
