    },
    "status_effects": {
      "type": "array",
      "minItems": 1,
      "description": "Status effect definitions applied to entities.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "description",
          "max_stacks",
          "tick_damage",
          "blocks_healing",
          "reduces_accuracy",
          "reduces_damage",
          "grants_invisibility"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$",
            "description": "Stable snake_case identifier for the status effect."
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "Display name shown to the player."
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "description": "Player-facing description of the status effect."
          },
          "max_stacks": {
            "type": "integer",
            "minimum": 1,
            "description": "Maximum number of stacks allowed."
          },
          "tick_damage": {
            "type": "integer",
            "minimum": 0,
            "description": "Damage dealt per tick while the effect is active."
          },
          "blocks_healing": {
            "type": "boolean",
            "description": "Whether healing is prevented while the effect is active."
          },
          "reduces_accuracy": {
            "type": "integer",
            "minimum": 0,
            "description": "Flat accuracy penalty applied while active."
          },
          "reduces_damage": {
            "type": "integer",
            "minimum": 0,
            "description": "Flat damage penalty applied while active."
          },
          "grants_invisibility": {
            "type": "boolean",
            "description": "Whether the effect grants invisibility."
          }
