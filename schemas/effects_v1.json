            "type": "object",
            "additionalProperties": false,
            "required": ["id", "condition", "target", "effect"],
            "properties": {
              "condition": {
                "type": "object",
                "additionalProperties": false,
                "required": ["low_hp"],
                "properties": {
                  "low_hp": {
                    "type": "integer",
                    "minimum": 0,
                    "description": "HP threshold at or below which the effect triggers."
                  }
                },
                "description": "Condition based on current hit points."
              },
              "effect": {
                "type": "string",
                "minLength": 1,
                "description": "Effect opcode/animation string."
              },
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$",
                "description": "Stable snake_case identifier for the effect entry."
              },
              "target": {
                "type": "string",
                "enum": ["player", "ui", "enemy", "environment", "tile"],
                "description": "Target layer to apply the effect."
              }
            }
          },
