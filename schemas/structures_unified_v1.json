{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://saltglass-steppe.game/schemas/structures_unified_v1.json",
  "title": "Unified Structure Schema",
  "description": "Unified schema for all placeable structures (buildings, ruins, POIs). Combines prefabs and structure_templates into single format.",
  "type": "object",
  "required": ["schema", "structures"],
  "properties": {
    "schema": {
      "type": "string",
      "const": "structures_unified_v1",
      "description": "Schema version identifier"
    },
    "structures": {
      "type": "array",
      "description": "Array of structure definitions",
      "items": {
        "$ref": "#/definitions/Structure"
      }
    }
  },
  "definitions": {
    "Structure": {
      "type": "object",
      "required": ["id", "usage", "legend"],
      "oneOf": [
        {
          "required": ["pattern_file"]
        },
        {
          "required": ["pattern"]
        }
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "description": "Unique identifier (snake_case)"
        },
        "usage": {
          "type": "string",
          "enum": ["standalone", "connectable"],
          "description": "standalone = complete POI (ruins, shrines), connectable = settlement building"
        },
        "pattern_file": {
          "type": "string",
          "description": "Path to external .txt pattern file (relative to data/). Mutually exclusive with 'pattern'."
        },
        "pattern": {
          "type": "array",
          "description": "Inline pattern as array of strings. Mutually exclusive with 'pattern_file'.",
          "items": {
            "type": "string"
          }
        },
        "legend": {
          "type": "object",
          "description": "Mapping of pattern characters to tile/entity definitions",
          "patternProperties": {
            "^.$": {
              "$ref": "#/definitions/LegendEntry"
            }
          }
        },
        "metadata": {
          "$ref": "#/definitions/StructureMetadata"
        }
      }
    },
    "LegendEntry": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["wall", "floor", "door", "interactable", "npc", "structure"],
          "description": "Type of legend entry"
        },
        "id": {
          "type": "string",
          "description": "ID reference (required for wall, floor, interactable, npc)"
        },
        "name": {
          "type": "string",
          "description": "Optional name (for NPCs)"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "enum": ["wall", "floor", "interactable", "npc"]
              }
            }
          },
          "then": {
            "required": ["id"]
          }
        }
      ]
    },
    "StructureMetadata": {
      "type": "object",
      "properties": {
        "description": {
          "type": "string",
          "description": "Lore-friendly description"
        },
        "faction": {
          "type": "string",
          "description": "Faction ID (null for neutral)"
        },
        "npc_count": {
          "type": "integer",
          "minimum": 0,
          "default": 0,
          "description": "Number of NPCs to spawn"
        },
        "npc_types": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Types of NPCs (e.g., 'merchant', 'guard')"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Tags for filtering (e.g., 'residential', 'religious')"
        },
        "weight": {
          "type": "number",
          "minimum": 0.0,
          "default": 1.0,
          "description": "Weight for random selection"
        },
        "clear_area": {
          "$ref": "#/definitions/ClearArea",
          "description": "Area to clear around structure (for standalone POIs)"
        },
        "entrance_side": {
          "type": "string",
          "enum": ["north", "south", "east", "west", "any"],
          "default": "any",
          "description": "Preferred entrance direction (for connectable buildings)"
        },
        "has_interior": {
          "type": "boolean",
          "default": false,
          "description": "Whether building has separate interior map"
        }
      }
    },
    "ClearArea": {
      "type": "object",
      "required": ["shape", "center_x", "center_y"],
      "properties": {
        "shape": {
          "type": "string",
          "enum": ["circle", "rectangle"],
          "description": "Shape of clear area"
        },
        "radius": {
          "type": "integer",
          "minimum": 1,
          "description": "Radius (for circle shape)"
        },
        "width": {
          "type": "integer",
          "minimum": 1,
          "description": "Width (for rectangle shape)"
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "description": "Height (for rectangle shape)"
        },
        "center_x": {
          "type": "integer",
          "minimum": 0,
          "description": "X coordinate of center (relative to pattern)"
        },
        "center_y": {
          "type": "integer",
          "minimum": 0,
          "description": "Y coordinate of center (relative to pattern)"
        }
      }
    }
  }
}
