{
  "$id": "https://saltglass-steppe.game/schemas/tutorial_v1.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Tutorial Schema",
  "type": "object",
  "description": "Tutorial messages and control hints shown to players.",
  "additionalProperties": false,
  "required": ["messages", "control_hints"],
  "properties": {
    "control_hints": {
      "type": "array",
      "minItems": 1,
      "description": "Short control hints displayed in the UI.",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "messages": {
      "type": "array",
      "minItems": 1,
      "description": "Triggered tutorial message definitions.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "trigger", "text", "highlight", "dismiss_key"],
        "properties": {
          "dismiss_key": {
            "type": "string",
            "minLength": 1,
            "description": "Key or token used to dismiss the message."
          },
          "highlight": {
            "type": "string",
            "minLength": 1,
            "description": "UI highlight category for the tutorial message."
          },
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$",
            "description": "Stable snake_case identifier for the message."
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "description": "Message body shown to the player."
          },
          "trigger": {
            "type": "string",
            "minLength": 1,
            "description": "Trigger name that causes the message to display."
          }
        }
      }
    }
  }
}
