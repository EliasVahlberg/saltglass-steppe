{
  "$id": "https://saltglass-steppe.game/schemas/skills_v1.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Skills Schema",
  "deprecated": true,
  "x-deprecated-by": "abilities_v1.json",
  "x-deprecation-note": "Pending consolidation into abilities_v1.json (category=skill).",
  "type": "array",
  "description": "Skill definitions that grant passive bonuses and progression requirements.",
  "minItems": 1,
  "items": {
    "oneOf": [
      {
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "name",
          "category",
          "description",
          "max_level",
          "base_cost",
          "prerequisites",
          "passive_effects"
        ],
        "properties": {
          "base_cost": {
            "type": "integer",
            "minimum": 0,
            "description": "Skill point cost to purchase the first level."
          },
          "category": {
            "type": "string",
            "enum": ["combat", "survival", "athletics", "social", "crafting"],
            "description": "Skill category for grouping in UI and progression."
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "description": "Player-facing explanation of the skill's benefits."
          },
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$",
            "description": "Stable snake_case identifier for the skill."
          },
          "max_level": {
            "type": "integer",
            "minimum": 1,
            "description": "Maximum attainable level for this skill."
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "Display name shown to the player."
          },
          "passive_effects": {
            "type": "array",
            "minItems": 1,
            "description": "Passive bonuses granted per level.",
            "items": {
              "additionalProperties": false,
              "type": "object",
              "required": ["effect_type", "target", "value_per_level", "max_value"],
              "properties": {
                "effect_type": {
                  "type": "string",
                  "enum": [
                    "accuracy_bonus",
                    "armor_bonus",
                    "buy_price_reduction",
                    "craft_quality",
                    "craft_success",
                    "damage_bonus",
                    "detection_reduction",
                    "encounter_reduction",
                    "flee_bonus",
                    "healing_bonus",
                    "map_reveal",
                    "resource_efficiency",
                    "sell_price_bonus"
                  ],
                  "description": "Type of passive modifier applied by the skill."
                },
                "max_value": {
                  "type": "number",
                  "minimum": 0,
                  "description": "Upper cap for the total modifier across all levels."
                },
                "target": {
                  "type": "string",
                  "enum": [
                    "combat",
                    "crafting",
                    "defense",
                    "medicine",
                    "melee",
                    "navigation",
                    "ranged",
                    "stealth",
                    "survival",
                    "trading",
                    "travel"
                  ],
                  "description": "Subsystem or tag affected by the passive modifier."
                },
                "value_per_level": {
                  "type": "number",
                  "minimum": 0,
                  "description": "Increment applied per skill level."
                }
              }
            }
          },
          "prerequisites": {
            "type": "array",
            "maxItems": 0,
            "description": "No prerequisites for this skill."
          }
        }
      },
      {
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "name",
          "category",
          "description",
          "max_level",
          "base_cost",
          "prerequisites",
          "passive_effects"
        ],
        "properties": {
          "base_cost": {
            "type": "integer",
            "minimum": 0,
            "description": "Skill point cost to purchase the first level."
          },
          "category": {
            "type": "string",
            "enum": ["combat", "survival", "athletics", "social", "crafting"],
            "description": "Skill category for grouping in UI and progression."
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "description": "Player-facing explanation of the skill's benefits."
          },
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$",
            "description": "Stable snake_case identifier for the skill."
          },
          "max_level": {
            "type": "integer",
            "minimum": 1,
            "description": "Maximum attainable level for this skill."
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "Display name shown to the player."
          },
          "passive_effects": {
            "type": "array",
            "minItems": 1,
            "description": "Passive bonuses granted per level.",
            "items": {
              "additionalProperties": false,
              "type": "object",
              "required": ["effect_type", "target", "value_per_level", "max_value"],
              "properties": {
                "effect_type": {
                  "type": "string",
                  "enum": [
                    "accuracy_bonus",
                    "armor_bonus",
                    "buy_price_reduction",
                    "craft_quality",
                    "craft_success",
                    "damage_bonus",
                    "detection_reduction",
                    "encounter_reduction",
                    "flee_bonus",
                    "healing_bonus",
                    "map_reveal",
                    "resource_efficiency",
                    "sell_price_bonus"
                  ],
                  "description": "Type of passive modifier applied by the skill."
                },
                "max_value": {
                  "type": "number",
                  "minimum": 0,
                  "description": "Upper cap for the total modifier across all levels."
                },
                "target": {
                  "type": "string",
                  "enum": [
                    "combat",
                    "crafting",
                    "defense",
                    "medicine",
                    "melee",
                    "navigation",
                    "ranged",
                    "stealth",
                    "survival",
                    "trading",
                    "travel"
                  ],
                  "description": "Subsystem or tag affected by the passive modifier."
                },
                "value_per_level": {
                  "type": "number",
                  "minimum": 0,
                  "description": "Increment applied per skill level."
                }
              }
            }
          },
          "prerequisites": {
            "type": "array",
            "minItems": 1,
            "description": "Skill prerequisites that must be met before unlocking.",
            "items": {
              "additionalProperties": false,
              "type": "object",
              "required": ["skill_id", "required_level"],
              "properties": {
                "required_level": {
                  "type": "integer",
                  "minimum": 1,
                  "description": "Minimum level needed in the prerequisite skill."
                },
                "skill_id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*$",
                  "description": "Skill id that gates this skill."
                }
              }
            }
          }
        }
      }
    ]
  }
}
