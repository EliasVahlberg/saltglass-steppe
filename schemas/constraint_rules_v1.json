{
  "$id": "https://saltglass-steppe.game/schemas/constraint_rules_v1.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "required": [
    "rules"
  ],
  "properties": {
    "rules": {
      "items": {
        "oneOf": [
          {
            "additionalProperties": false,
            "properties": {
              "constraint_type": {
                "type": "string",
                "enum": [
                  "tactical",
                  "safe_zone",
                  "escape_route",
                  "objective_accessibility"
                ],
                "description": "Constraint category used by validators."
              },
              "enabled": {
                "type": "boolean",
                "description": "Boolean toggle."
              },
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$",
                "description": "Constraint rule id (snake_case).",
                "minLength": 1
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "description": "Display name for the rule."
              },
              "parameters": {
                "additionalProperties": false,
                "properties": {
                  "max_open_ratio": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1,
                    "description": "Maximum allowed open area ratio (0-1)."
                  },
                  "min_chokepoints": {
                    "type": "integer",
                    "minimum": 0,
                    "description": "Minimum required chokepoints."
                  }
                },
                "type": "object",
                "description": "Object for `parameters`."
              },
              "severity": {
                "type": "string",
                "enum": [
                  "warning",
                  "critical"
                ],
                "description": "Severity level when the constraint fails."
              }
            },
            "required": [
              "id",
              "name",
              "constraint_type",
              "parameters",
              "severity",
              "enabled"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
