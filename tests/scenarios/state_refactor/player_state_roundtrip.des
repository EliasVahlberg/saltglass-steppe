# PlayerState Serialization Roundtrip Test
# Purpose: Verify PlayerState can be saved and loaded without data loss
# Expected: All player state fields survive save/load cycle

# Setup player with non-default state
seed 42
spawn player 10 10
set player.hp 15
set player.max_hp 25
set player.ap 2
set player.max_ap 6
set player.xp 150
set player.level 2

# Add inventory items
give player brine_vial
give player salt_knife
give player scripture_shard

# Equip gear
equip player salt_knife weapon
equip player salt_vest jacket

# Add adaptations
add_adaptation player prismhide
add_adaptation player saltblood

# Apply status effects
apply_status player poison 3 1
apply_status player blessed 5 2

# Save initial state
save_state initial_state

# Perform some actions to modify state
move player east
use_item player 0
wait 1

# Load saved state
load_state initial_state

# Verify all fields survived roundtrip
assert player.hp == 15
assert player.max_hp == 25
assert player.ap == 2
assert player.max_ap == 6
assert player.xp == 150
assert player.level == 2
assert player.x == 10
assert player.y == 10

# Verify inventory
assert inventory_contains brine_vial
assert inventory_contains salt_knife
assert inventory_contains scripture_shard
assert inventory_size == 3

# Verify equipment
assert equipped_in_slot weapon salt_knife
assert equipped_in_slot jacket salt_vest

# Verify adaptations
assert player_has_adaptation prismhide
assert player_has_adaptation saltblood
assert adaptation_count == 2

# Verify status effects
assert has_status_effect poison
assert has_status_effect blessed
assert status_effect_count == 2