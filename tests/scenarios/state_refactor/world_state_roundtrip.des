# WorldState Serialization Roundtrip Test
# Tests that map, entities, environmental state, and spatial indexing survive save/load
seed 42

# Setup initial state with diverse entities and environment
spawn player 10 10
spawn enemy mirage_hound 15 15
spawn npc salt_pilgrim 8 12
spawn item brine_vial 20 20
spawn item salt_knife 5 8

# Create environmental state
trigger_storm glass intensity 2
set_weather sandstorm

# Move entities to create spatial index entries
move player east
move player north
attack player east

# Verify pre-save state
assert player.x == 11
assert player.y == 9
assert enemy_at 15 15 mirage_hound
assert npc_at 8 12 salt_pilgrim
assert item_at 20 20 brine_vial
assert item_at 5 8 salt_knife
assert storm_active
assert weather sandstorm

# Save game state
save_state test_worldstate

# Modify state to verify load overwrites
move player south
spawn enemy test_dummy 1 1

# Load saved state
load_state test_worldstate

# Verify all data restored correctly
assert player.x == 11
assert player.y == 9
assert enemy_at 15 15 mirage_hound
assert npc_at 8 12 salt_pilgrim
assert item_at 20 20 brine_vial
assert item_at 5 8 salt_knife
assert storm_active
assert weather sandstorm

# Verify spatial indexing rebuilt - test pathfinding and FOV
move player east
assert player.x == 12
attack player south
assert enemy_hp mirage_hound < 100

# Test spatial queries work
assert can_see 15 15
assert no_enemy_at 1 1