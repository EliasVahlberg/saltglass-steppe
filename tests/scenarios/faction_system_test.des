# Faction System Test Scenario
# Tests starting reputation, quest rewards, and faction menu

# Start as pilgrim (should have +10 MirrorMonks, +5 ArchiveDrones)
new_game 12345 pilgrim

# Check starting reputation
assert player.faction_reputation["MirrorMonks"] == 10
assert player.faction_reputation["ArchiveDrones"] == 5

# Manually modify reputation to test thresholds
set player.faction_reputation["MirrorMonks"] = -60
assert player.faction_reputation["MirrorMonks"] == -60

