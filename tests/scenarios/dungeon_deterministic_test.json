{
  "name": "dungeon_deterministic_test",
  "description": "Validate same seed produces same dungeon layout",
  "seed": 12345,
  "world_x": 8,
  "world_y": 8,
  "poi_type": "dungeon",
  "player": {
    "x": 10,
    "y": 10,
    "hp": 50,
    "max_hp": 50,
    "ap": 10
  },
  "actions": [
    {
      "turn": 0,
      "action": {
        "type": "log",
        "query": "player_position"
      }
    },
    {
      "turn": 0,
      "action": {
        "type": "wait",
        "turns": 1
      }
    }
  ],
  "assertions": [
    {
      "at_end": true,
      "check": {
        "type": "player_position",
        "x": 10,
        "y": 10
      },
      "message": "Player position should be deterministic"
    },
    {
      "at_end": true,
      "check": {
        "type": "connectivity_ratio",
        "op": "ge",
        "value": 0.8
      },
      "message": "Connectivity should be deterministic"
    },
    {
      "at_end": true,
      "check": {
        "type": "enemy_count",
        "op": "ge",
        "value": 1
      },
      "message": "Enemy spawns should be deterministic"
    }
  ]
}