{
  "name": "dungeon_deterministic_test",
  "description": "Validate same seed produces consistent dungeon layout",
  "seed": 12345,
  "player": {
    "hp": 50,
    "max_hp": 50,
    "ap": 10
  },
  "actions": [
    {
      "turn": 0,
      "action": {
        "type": "wait",
        "turns": 1
      }
    }
  ],
  "assertions": [
    {
      "at_end": true,
      "check": {"type": "player_on_walkable_tile"},
      "message": "Player should spawn on walkable tile in dungeon"
    },
    {
      "at_end": true,
      "check": {
        "type": "connectivity_ratio",
        "op": "ge",
        "value": 0.8
      },
      "message": "Dungeon connectivity should meet threshold"
    },
    {
      "at_end": true,
      "check": {
        "type": "enemy_count",
        "op": "ge",
        "value": 1
      },
      "message": "Dungeon should have enemies"
    }
  ],
  "map_setup": {
    "poi_type": "dungeon"
  }
}
