{
  "name": "settlement_generation_test",
  "description": "Test that player can move in a generated map",
  "seed": 12345,
  "player": {
    "x": 10,
    "y": 10,
    "hp": 50,
    "max_hp": 50,
    "ap": 10
  },
  "entities": [],
  "actions": [
    {"turn": 0, "action": {"type": "move", "dx": 0, "dy": -1}},
    {"turn": 0, "action": {"type": "move", "dx": 0, "dy": 1}}
  ],
  "assertions": [
    {
      "at_end": true,
      "check": {"type": "player_alive"},
      "message": "Player should be alive after moving"
    },
    {
      "at_end": true,
      "check": {"type": "player_on_walkable_tile"},
      "message": "Player should be on walkable tile"
    }
  ]
}
