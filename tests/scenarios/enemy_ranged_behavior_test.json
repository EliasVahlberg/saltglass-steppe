{
  "name": "enemy_ranged_behavior_test",
  "description": "Test that a ranged enemy attacks from a distance (not adjacent)",
  "seed": 42,
  "player": {
    "x": 10,
    "y": 10,
    "hp": 50,
    "max_hp": 50,
    "ap": 10,
    "max_ap": 10
  },
  "mocks": {
    "combat_always_hit": true,
    "combat_fixed_damage": 3
  },
  "map_setup": {
    "clear_radius": 8
  },
  "entities": [
    {"entity_type": "enemy", "id": "storm_herald", "x": 14, "y": 10, "hp": 20, "ai_disabled": false}
  ],
  "actions": [
    {
      "turn": 0,
      "action": { "type": "end_turn" }
    }
  ],
  "assertions": [
    {
      "after_turn": 0,
      "check": { "type": "player_hp", "op": "lt", "value": 50 },
      "message": "Ranged attack should hit"
    },
    {
      "after_turn": 0,
      "check": { "type": "enemy_at", "x": 14, "y": 10, "alive": true },
      "message": "Enemy should not move adjacent"
    },
    {
      "at_end": true,
      "check": { "type": "player_alive" },
      "message": "Player should survive the test"
    }
  ]
}