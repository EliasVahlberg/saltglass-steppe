{
  "name": "Level-Up Stat Allocation Test",
  "description": "Test that killing enemies grants XP, level up gives stat points, and points can be allocated",
  "seed": 100,
  "player": {
    "x": 28,
    "y": 8,
    "hp": 50,
    "max_hp": 50,
    "ap": 10,
    "max_ap": 10,
    "xp": 242
  },
  "mocks": {
    "combat_always_hit": true,
    "combat_fixed_damage": 100
  },
  "entities": [
    {"entity_type": "enemy", "id": "shard_spider", "x": 29, "y": 8, "hp": 1, "ai_disabled": true}
  ],
  "actions": [
    {"turn": 0, "action": {"type": "attack", "target_x": 29, "target_y": 8}},
    {"turn": 0, "action": {"type": "allocate_stat", "stat": "max_hp"}},
    {"turn": 0, "action": {"type": "allocate_stat", "stat": "max_hp"}},
    {"turn": 0, "action": {"type": "allocate_stat", "stat": "reflex"}}
  ],
  "assertions": [
    {
      "at_start": true,
      "check": {"type": "player_xp", "op": "eq", "value": 242},
      "message": "Player should start with 242 XP"
    },
    {
      "at_start": true,
      "check": {"type": "player_level", "op": "eq", "value": 1},
      "message": "Player should start at level 1"
    },
    {
      "at_end": true,
      "check": {"type": "player_xp", "op": "eq", "value": 250},
      "message": "Player should have 250 XP after killing spider (242 + 8)"
    },
    {
      "at_end": true,
      "check": {"type": "player_level", "op": "eq", "value": 2},
      "message": "Player should be level 2 after reaching 250 XP"
    },
    {
      "at_end": true,
      "check": {"type": "pending_stat_points", "op": "eq", "value": 0},
      "message": "All 3 stat points should be allocated"
    },
    {
      "at_end": true,
      "check": {"type": "player_hp", "op": "eq", "value": 60},
      "message": "Player HP should be 60 (50 + 2×5 from allocating max_hp twice)"
    }
  ]
}
