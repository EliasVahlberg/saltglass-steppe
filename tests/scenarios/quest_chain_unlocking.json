{
  "name": "quest_chain_unlocking",
  "description": "Tests that completing a quest unlocks and auto-accepts the next quest in the chain",
  "seed": 12345,
  "player": {
    "x": 10,
    "y": 10,
    "hp": 100,
    "max_hp": 100
  },
  "actions": [
    {"turn": 0, "action": {"type": "accept_quest", "quest_id": "first_steps"}},
    {"turn": 1, "action": {"type": "teleport", "x": 15, "y": 15}}
  ],
  "assertions": [
    {
      "after_turn": 0,
      "check": {"type": "quest_active", "quest_id": "first_steps"},
      "message": "first_steps should be active after accepting"
    },
    {
      "after_turn": 1,
      "check": {"type": "quest_completed", "quest_id": "first_steps"},
      "message": "first_steps should auto-complete after reaching (15,15)"
    },
    {
      "after_turn": 1,
      "check": {"type": "quest_active", "quest_id": "choose_your_path"},
      "message": "choose_your_path should be auto-accepted after first_steps completes"
    }
  ]
}
