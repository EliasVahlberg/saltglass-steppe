{
  "name": "effect_kill_trace",
  "description": "Assert that killing an enemy produces RemoveEnemy and SetPlayerXp mutations in the trace",
  "seed": 100,
  "player": {"x": 5, "y": 5, "hp": 20, "max_hp": 20, "ap": 10, "max_ap": 10},
  "entities": [{"entity_type": "enemy", "id": "mirage_hound", "x": 6, "y": 5, "hp": 1, "ai_disabled": true}],
  "mocks": {"combat_always_hit": true},
  "actions": [
    {"turn": 0, "action": {"type": "attack", "target_x": 6, "target_y": 5}}
  ],
  "assertions": [
    {"at_end": true, "check": {"type": "effect_occurred", "pattern": "RemoveEnemy"}, "message": "RemoveEnemy mutation must appear on kill"},
    {"at_end": true, "check": {"type": "effect_occurred", "pattern": "SetPlayerXp"}, "message": "XP mutation must appear on kill"},
    {"at_end": true, "check": {"type": "effect_occurred", "pattern": "SetEnemyHp"}, "message": "Damage mutation must appear"},
    {"at_end": true, "check": {"type": "effect_count", "pattern": "SetEnemyHp", "op": "eq", "value": 1}, "message": "Exactly one damage mutation per attack"}
  ]
}
