{
  "name": "Loot System Event Test",
  "description": "Test that killing an enemy triggers loot drops",
  "seed": 12345,
  "world_x": 5,
  "world_y": 5,
  "player": {"x": 10, "y": 10, "hp": 100, "max_hp": 100},
  "mocks": {"combat_always_hit": true, "combat_fixed_damage": 100},
  "entities": [
    {"entity_type": "enemy", "id": "mirage_hound", "x": 11, "y": 10, "hp": 1, "ai_disabled": true}
  ],
  "actions": [
    {"turn": 0, "action": {"type": "move", "dx": 1, "dy": 0}, "comment": "Kill enemy via bump"}
  ],
  "assertions": [
    {"at_end": true, "check": {"type": "enemy_count", "op": "eq", "value": 0}, "message": "Enemy should be dead"},
    {"at_end": true, "check": {"type": "message_contains", "text": "You kill"}, "message": "Kill message should be logged"},
    {"at_end": true, "check": {"type": "message_contains", "text": "+12 XP"}, "message": "XP gain message should be logged"}
  ]
}
