{
  "name": "effect_miss_trace",
  "description": "Assert that a miss produces a miss log and no damage/kill mutations",
  "seed": 100,
  "player": {"x": 5, "y": 5, "hp": 20, "max_hp": 20, "ap": 10, "max_ap": 10},
  "entities": [{"entity_type": "enemy", "id": "mirage_hound", "x": 6, "y": 5, "hp": 5, "ai_disabled": true}],
  "mocks": {"combat_always_hit": false},
  "actions": [
    {"turn": 0, "action": {"type": "attack", "target_x": 6, "target_y": 5}}
  ],
  "assertions": [
    {"at_end": true, "check": {"type": "effect_not_occurred", "pattern": "RemoveEnemy"}, "message": "No kill on a miss"},
    {"at_end": true, "check": {"type": "effect_not_occurred", "pattern": "SetEnemyHp"}, "message": "No damage on a miss"},
    {"at_end": true, "check": {"type": "effect_not_occurred", "pattern": "SetPlayerXp"}, "message": "No XP on a miss"}
  ]
}
