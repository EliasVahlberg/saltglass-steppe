{
  "name": "Event Bus Test",
  "description": "Test that combat events produce observable state changes",
  "seed": 42,
  "world_x": 5,
  "world_y": 5,
  "player": {"x": 10, "y": 10, "hp": 50, "max_hp": 50, "xp": 0},
  "mocks": {"combat_always_hit": true, "combat_fixed_damage": 100},
  "entities": [
    {"entity_type": "enemy", "id": "shard_spider", "x": 11, "y": 10, "hp": 1, "ai_disabled": true}
  ],
  "actions": [
    {"turn": 0, "action": {"type": "move", "dx": 1, "dy": 0}, "comment": "Kill enemy via bump"}
  ],
  "assertions": [
    {"at_end": true, "check": {"type": "enemy_count", "op": "eq", "value": 0}, "message": "Enemy should be dead"},
    {"at_end": true, "check": {"type": "player_xp", "op": "eq", "value": 8}, "message": "Player should gain 8 XP from shard_spider"},
    {"at_end": true, "check": {"type": "message_contains", "text": "You kill"}, "message": "Kill message should be logged"}
  ]
}
